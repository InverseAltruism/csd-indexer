{
  "name": "csd-indexer",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "description": "Standalone, reorg-safe indexer + explorer for Compute Substrate (CSD), L2 of the no-fork ecosystem. Serves the Esplora REST contract plus merkle inclusion proofs for the L0 light client, per-attester data and address history.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "index": "tsx src/cli.ts index",
    "serve": "tsx src/server.ts",
    "run-all": "tsx src/cli.ts run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --max-diagnostics=none .",
    "check:dashes-paths": "node scripts/check-dashes-paths.mjs",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@inversealtruism/csd-codec": "0.1.18",
    "@inversealtruism/csd-crypto": "0.1.19",
    "@inversealtruism/csd-light": "0.1.24",
    "express": "^4.21.2",
    "pg": "^8.21.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/express": "4.17.25",
    "@types/node": "22.19.20",
    "@types/pg": "8.20.0",
    "@types/ws": "8.18.1",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3"
  }
}
